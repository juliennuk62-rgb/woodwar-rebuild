{
  "_meta": {
    "source": "carac_batiments.php + fr_leng.php + prix_tourelles.php",
    "count": 16,
    "notes": "config.php says nb_bat=14 but carac_batiments.php defines 16. carac_batiments.php is the source of truth. Turret and Motte prices are DYNAMIC — they scale with the player's current total defense (sum of defense*count across all owned unit types, in barracks, in bases, and in battalions). See 'turret_pricing' below for the formulas."
  },
  "turret_pricing": {
    "source": "prix_tourelles.php",
    "how_it_works": "First compute total_defense = sum over all 12 unit types of (unit.defense * total_count_owned). Then each turret has a 'defense bonus tier' (def_tN) computed as a fraction of total_defense, and a cost derived from that tier.",
    "defense_bonus_fraction": {
      "turret_defense":   0.000625,
      "turret_deadly":    0.003125,
      "turret_destroyer": 0.01,
      "motte":            0.0000625
    },
    "cost_formula": {
      "or":   "round((def_t + round(def_t / 10)) * 1.0)",
      "bois": "round((def_t + round(def_t / 10)) * 0.75)"
    },
    "note": "def_t = round(total_defense * defense_bonus_fraction). The turret's defense contribution in combat equals def_t. So building a turret when you have more troops makes it stronger AND more expensive — economically neutral relative to your army size."
  },
